# MediaCleaner Configuration

# Application Settings
APP_NAME=MediaCleaner
DEBUG=false
API_PREFIX=/api

# Paths (adjust for your environment)
# For Docker, use /data as the mount point
# For local dev, use your actual movie directory
DATA_DIR=/data
THUMBNAIL_DIR=/app/public/thumbnails
DATABASE_PATH=/app/data/mediacleaner.db

# Media Processing Settings
# Minimum file size in MB to consider (ignore samples/trailers)
MIN_FILE_SIZE_MB=300

# Video file extensions to scan
# VIDEO_EXTENSIONS=[".mkv", ".mp4", ".avi", ".m4v", ".mov"]

# Thumbnail settings
THUMBNAIL_TIMESTAMP_RATIO=0.25  # Take screenshot at 25% of duration
THUMBNAIL_WIDTH=640              # Width in pixels

# Performance Settings
MAX_CONCURRENT_SCANS=4          # Concurrent FFprobe operations
MAX_CONCURRENT_THUMBNAILS=2     # Concurrent thumbnail generations

# FFmpeg Paths (usually auto-detected)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
